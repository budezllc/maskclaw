[Unit]
Description=MaskClaw Caddy (dashboard + reverse proxy)
After=network-online.target maskclaw-server.service maskclaw-hostd.service
Wants=network-online.target
Conflicts=caddy.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Environment=HOME=/var/lib/maskclaw
Environment=XDG_CONFIG_HOME=/var/lib/maskclaw
Environment=XDG_DATA_HOME=/var/lib/maskclaw/.local/share
ExecStart=/usr/bin/caddy run --config /etc/maskclaw/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

