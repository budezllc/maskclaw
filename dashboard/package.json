{
  "name": "maskclaw-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode sidecar",
    "dev:appliance": "vite --host 127.0.0.1 --mode appliance",
    "build": "tsc --noEmit && vite build --mode sidecar",
    "build:appliance": "tsc --noEmit && vite build --mode appliance",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
